generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum NotificationType {
  REPLY
  MENTION
  LIKE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Suit le transcodage MediaConvert de la vidéo d'une leçon.
enum VideoStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

model User {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  avatarColor String   @default("lagon") @map("avatar_color")
  bio         String?
  showEmail   Boolean  @default(false) @map("show_email")
  showPhone   Boolean  @default(false) @map("show_phone")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships       Membership[]
  posts             Post[]
  comments          Comment[]
  postLikes         PostLike[]
  commentLikes      CommentLike[]
  reports           Report[]       @relation("ReportedBy")
  reviewedReports   Report[]       @relation("ReviewedBy")
  notifications     Notification[] @relation("NotificationRecipient")
  notificationActs  Notification[] @relation("NotificationActor")

  classesCreated      Classe[]
  classeMemberships   ClasseMember[]
  invitationsSent     ClasseInvitation[]
  modulesCreated      Module[]
  classeModulesAdded  ClasseModule[]

  @@map("users")
}

model Community {
  id          String   @id @default(uuid())
  name        String
  shortName   String   @map("short_name")
  description String
  city        String
  bannerUrl   String?  @map("banner_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  categories    Category[]
  posts         Post[]
  reports       Report[]
  notifications Notification[]
  classes       Classe[]
  modules       Module[]

  @@map("communities")
}

model Membership {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  communityId String         @map("community_id")
  role        MembershipRole @default(MEMBER)
  joinedAt    DateTime       @default(now()) @map("joined_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, role])
  @@map("memberships")
}

model Category {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  name        String
  color       String
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@unique([communityId, name])
  @@index([communityId, order])
  @@map("categories")
}

model Post {
  id            String   @id @default(uuid())
  communityId   String   @map("community_id")
  authorId      String   @map("author_id")
  categoryId    String   @map("category_id")
  title         String
  content       String   @db.Text
  attachmentUrl String?  @map("attachment_url")
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  community     Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments      Comment[]
  likes         PostLike[]
  reports       Report[]
  notifications Notification[]

  @@index([communityId, createdAt(sort: Desc)])
  @@index([communityId, pinned, createdAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post     Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]     @relation("CommentReplies")
  likes    CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Report {
  id           String       @id @default(uuid())
  communityId  String       @map("community_id")
  postId       String       @map("post_id")
  reporterId   String       @map("reporter_id")
  reason       String
  status       ReportStatus @default(PENDING)
  reviewedById String?      @map("reviewed_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  reviewedAt   DateTime?    @map("reviewed_at")

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User      @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt])
  @@map("reports")
}

model Notification {
  id          String           @id @default(uuid())
  communityId String           @map("community_id")
  recipientId String           @map("recipient_id")
  actorId     String           @map("actor_id")
  postId      String?          @map("post_id")
  type        NotificationType
  message     String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  recipient User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
//  CLASSES
// ---------------------------------------------------------------------------

/// Salle de classe créée par un admin. Ses inscrits sont dans ClasseMember,
/// ses modules dans ClasseModule.
model Classe {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  createdById String   @map("created_by_id")
  name        String
  description String?
  coverUrl    String?  @map("cover_url")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members     ClasseMember[]
  invitations ClasseInvitation[]
  modules     ClasseModule[]

  @@unique([communityId, name])
  @@index([communityId, isArchived])
  @@map("classes")
}

/// Inscrit d'une classe : ajouté directement (déjà sur la plateforme)
/// ou via une invitation acceptée.
model ClasseMember {
  id           String   @id @default(uuid())
  classeId     String   @map("classe_id")
  userId       String   @map("user_id")
  invitationId String?  @unique @map("invitation_id")
  joinedAt     DateTime @default(now()) @map("joined_at")

  classe     Classe            @relation(fields: [classeId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation ClasseInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([classeId, userId])
  @@index([userId])
  @@map("classe_members")
}

/// Invitation par email. À l'acceptation (en une transaction) : création du
/// User, du ClasseMember et, si besoin, du Membership de la communauté.
model ClasseInvitation {
  id          String           @id @default(uuid())
  classeId    String           @map("classe_id")
  invitedById String           @map("invited_by_id")
  email       String
  /// Jeton aléatoire placé dans le lien envoyé par email.
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  classe    Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  invitedBy User          @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  member    ClasseMember?

  // Pour ré-inviter un email : mettre à jour la ligne (nouveau token et expiration)
  @@unique([classeId, email])
  @@index([email])
  @@index([classeId, status])
  @@map("classe_invitations")
}

// ---------------------------------------------------------------------------
//  COURS (modules réservés aux admins : contrôle fait côté API)
// ---------------------------------------------------------------------------

/// Module indépendant : il existe dans la bibliothèque de la communauté,
/// puis l'admin l'ajoute à une ou plusieurs classes via ClasseModule.
model Module {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  createdById String   @map("created_by_id")
  title       String
  description String?
  coverUrl    String?  @map("cover_url")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lessons   Lesson[]
  classes   ClasseModule[]

  @@index([communityId, published])
  @@map("modules")
}

/// Lien entre une classe et un module, avec l'ordre d'affichage.
model ClasseModule {
  id        String   @id @default(uuid())
  classeId  String   @map("classe_id")
  moduleId  String   @map("module_id")
  addedById String   @map("added_by_id")
  order     Int      @default(0)
  addedAt   DateTime @default(now()) @map("added_at")

  classe  Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)
  module  Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  addedBy User   @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([classeId, moduleId])
  @@index([classeId, order])
  @@index([moduleId])
  @@map("classe_modules")
}

/// Leçon d'un module, avec sa vidéo transcodée en HLS.
model Lesson {
  id             String      @id @default(uuid())
  moduleId       String      @map("module_id")
  title          String
  description    String?
  order          Int         @default(0)
  /// Clé S3 de la vidéo source.
  videoKey       String?     @map("video_key")
  /// Clé S3 du manifeste HLS (ex : courses/42/lesson-7/index.m3u8).
  hlsManifestKey String?     @map("hls_manifest_key")
  videoStatus    VideoStatus @default(PENDING) @map("video_status")
  durationSec    Int?        @map("duration_sec")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, order])
  @@map("lessons")
}